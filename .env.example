# Copia este archivo como .env.local y rellena con tus credenciales de Firebase
# Ve a https://console.firebase.google.com → Tu proyecto → Configuración → Aplicaciones web

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=securitysystem-4a79b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=securitysystem-4a79b
VITE_FIREBASE_STORAGE_BUCKET=securitysystem-4a79b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=245912437740
VITE_FIREBASE_APP_ID=1:245912437740:web:3347a73c81aa14e7a4b6c9
# Google OAuth Client ID para sincronización con Google Calendar
# Ve a https://console.cloud.google.com → APIs y servicios → Credenciales → Crear ID de cliente OAuth 2.0 (Aplicación web)
# Añade tu origen como JavaScript autorizado (ej: http://localhost:5173, https://tu-dominio.firebaseapp.com)
# Habilita Google Calendar API en Biblioteca de APIs
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
