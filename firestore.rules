rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: never expose the complete user directory
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // High-entropy, single-use invitations. A token only creates a pending request.
    match /groupInvitations/{token} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && (
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.admins
        );
      allow update: if request.auth != null
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Groups: membership is granted only by an administrator.
    match /groups/{groupId} {
      allow get: if request.auth != null
        && (request.auth.uid in resource.data.members || request.auth.uid == resource.data.createdBy);
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.admins ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingMembers']) &&
          request.auth.uid in request.resource.data.pendingMembers
        )
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Reminders: owner or recipient can read/write
    match /reminders/{reminderId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.get('sharedWith', [])
      );
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.ownerId ||
        (request.resource.data.isShared == true && request.auth.uid == request.resource.data.sharedFrom)
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        (resource.data.isShared == true && request.auth.uid == resource.data.sharedFrom)
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        (resource.data.isShared == true && request.auth.uid == resource.data.sharedFrom)
      );
    }

    // Shared reminders log
    match /sharedReminders/{shareId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.toUserId
      );
    }

  }
}