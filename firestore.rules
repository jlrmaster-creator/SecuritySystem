rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function isGroupAdmin(groupId) {
      return isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins;
    }

    function groupContainsUsers(groupId, firstUserId, secondUserId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return firstUserId in group.members && secondUserId in group.members;
    }

    function canReadMessage(message) {
      return isAuthenticated() && (
        (
          message.get('groupId', null) != null &&
          isGroupMember(message.groupId)
        ) ||
        (
          message.get('groupId', null) == null &&
          request.auth.uid == message.ownerId
        )
      );
    }

    function hasValidThreadFields(message) {
      return message.get('parentId', null) == null ||
        (
          message.get('parentId', null) is string &&
          message.get('threadId', null) is string
        );
    }

    // Privacy retention: every new message carries `expiresAt` (7 days) for the
    // Firestore TTL policy. Older clients may still omit it — the field stays
    // optional so their writes keep working — but when sent it must be a real
    // timestamp, otherwise the TTL engine would silently skip that document.
    function hasValidExpiry(data) {
      return data.get('expiresAt', null) == null ||
        (
          data.get('expiresAt', null) is timestamp
        );
    }

    // Only the owner can read a profile, plus any user who already shares at
    // least one group with them: that is how member names are loaded
    // (getGroupMembers). The previous check looked for the reader's UID inside
    // the profile's `groups` list (a list of GROUP ids), so it was always false
    // and every foreign profile read was denied. The client never renders
    // email addresses.
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            .get('groups', [])
            .hasAny(resource.data.get('groups', []))
        )
      );
      allow list: if false;
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'groups', 'email', 'uid', 'createdAt', 'retentionDays'
        ]);
      allow delete: if false;
    }

    // High-entropy, single-use invitations. A token only creates a pending request.
    match /groupInvitations/{token} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && (
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.admins
        )
        && request.resource.data.used == false
        && request.resource.data.expiresAt > request.time;
      allow update: if isAuthenticated()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    match /groupRequests/{requestId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && !(request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members);
      allow get, list: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.admins;
      allow delete: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.admins;
    }

    // Groups: membership is granted only by an administrator.
    match /groups/{groupId} {
      allow get: if isAuthenticated()
        && (request.auth.uid in resource.data.members || request.auth.uid == resource.data.createdBy);
      allow list: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.pendingMembers == [];
      allow update: if isAuthenticated() && (
        (
          (request.auth.uid == resource.data.createdBy || request.auth.uid in resource.data.admins)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'members', 'admins', 'pendingMembers'
          ])
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingMembers']) &&
          !(request.auth.uid in resource.data.members) &&
          request.auth.uid in request.resource.data.pendingMembers &&
          request.resource.data.pendingMembers.size() == resource.data.get('pendingMembers', []).size() + 1 &&
          request.resource.data.pendingMembers.hasAll(resource.data.get('pendingMembers', []))
        ) ||
        (
          request.auth.uid in resource.data.members &&
          !(request.auth.uid in request.resource.data.members) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        )
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    // Messages/events: sender and recipient must be members of the declared group.
    match /reminders/{reminderId} {
      allow read: if isAuthenticated() && (
        canReadMessage(resource.data)
      );
      allow create: if isAuthenticated()
        && hasValidExpiry(request.resource.data)
        && (
          (
            request.auth.uid == request.resource.data.ownerId &&
            request.resource.data.isShared == false &&
            hasValidThreadFields(request.resource.data) &&
            (
              request.resource.data.get('groupId', null) == null ||
              isGroupMember(request.resource.data.groupId)
            )
          ) ||
          (
            request.resource.data.isShared == true &&
            request.resource.data.get('groupId', null) != null &&
            request.resource.data.get('threadId', null) != null &&
            hasValidThreadFields(request.resource.data) &&
            request.auth.uid == request.resource.data.sharedFrom &&
            groupContainsUsers(
              request.resource.data.groupId,
              request.auth.uid,
              request.resource.data.ownerId
            )
          )
        );
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == resource.data.ownerId &&
          resource.data.isShared == false &&
          canReadMessage(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'status', 'updatedAt'
          ])
        ) ||
        (
          request.auth.uid == resource.data.sharedFrom &&
          canReadMessage(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedReminderId', 'updatedAt'])
        )
      );
      // Two ways to delete a message document:
      //  · your own copy (`ownerId == uid`): every member can drop a message
      //    from their own account — including the author dropping the original.
      //  · a copy I sent (`sharedFrom == uid`): only the author can retract the
      //    message for everyone. Copies carry the sender's uid in sharedFrom,
      //    so no member can ever remove another member's copy, nor the
      //    original of someone else. `.get()` keeps legacy documents without
      //    the field readable instead of erroring the whole delete.
      allow delete: if isAuthenticated()
        && (
          request.auth.uid == resource.data.ownerId ||
          request.auth.uid == resource.data.get('sharedFrom', null)
        );
    }

    // Shared reminders log
    match /sharedReminders/{shareId} {
      // Two independent paths, OR-ed in a single statement (same shape as
      // canReadMessage, which is already proven against list queries):
      //  · sender/recipient read their own logs. `.get()` is required here: in
      //    a list request Firestore only knows the fields used in the filters,
      //    and raw access to `resource.data.groupId` failed the whole query
      //    with "Property groupId is undefined on object", silencing both
      //    share subscriptions.
      //  · members read every log of a thread (deleteMessageThread lists by
      //    groupId). That branch only resolves when groupId is known — a
      //    single read, or a list filtered by groupId — never for open queries.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.get('fromUserId', null) ||
        request.auth.uid == resource.data.get('toUserId', null) ||
        (
          resource.data.get('groupId', null) is string &&
          isGroupMember(resource.data.groupId)
        )
      );
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.fromUserId
        && hasValidExpiry(request.resource.data)
        && groupContainsUsers(
          request.resource.data.groupId,
          request.resource.data.fromUserId,
          request.resource.data.toUserId
        );
      allow update: if isAuthenticated()
        && isGroupMember(resource.data.groupId)
        && (
          (
            request.auth.uid == resource.data.toUserId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt'])
          ) ||
          (
            request.auth.uid == resource.data.fromUserId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedReminderId', 'updatedAt'])
          )
        );
      // Only the two parties of the share may remove its log (the sender when
      // retracting the message, the recipient when discarding it). Group
      // membership alone no longer grants deletion.
      allow delete: if isAuthenticated()
        && (
          request.auth.uid == resource.data.get('fromUserId', null) ||
          request.auth.uid == resource.data.get('toUserId', null)
        );
    }

  }
}